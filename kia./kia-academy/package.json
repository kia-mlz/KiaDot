{
  "name": "@kia./kia-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Kia Academy — learning department package (courses, course exams, learning paths, learner state). One of the six kia. departments; isolated from the others by lint rule.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"**/*.ts\" --config ../../eslint.config.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@kia./brand": "workspace:*",
    "@kia./platform": "workspace:*",
    "@kia./shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/throttler": "^6.8.0",
    "acorn": "^8.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.8.3"
  }
}
