{
  "name": "@kia./kia-material",
  "version": "1.0.0",
  "private": true,
  "description": "Kia Material — Material Studio department package (source-shipped: apps/group transpiles it via transpilePackages).",
  "main": "./resources/index.ts",
  "types": "./resources/index.ts",
  "exports": {
    ".": "./resources/index.ts",
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.catalog.json",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.catalog.json --noEmit --pretty false",
    "test": "jest --config jest.catalog.config.mjs"
  },
  "dependencies": {
    "@kia./platform": "workspace:*",
    "@kia./shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "class-validator": "^0.15.1",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.1.4",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.3"
  }
}
