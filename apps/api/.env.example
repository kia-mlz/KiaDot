DATABASE_URL=postgresql://kia_academy:kia_academy@localhost:5432/kia_academy?schema=public
# Docker full stack: postgresql://kia_academy:kia_academy@postgres:5432/kia_academy?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development

# REQUIRED — use long random strings in any shared/staging/production environment (min 32 chars).
# JWT_SECRET and JWT_REFRESH_SECRET MUST be different in production.
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-a-different-long-string
JWT_REFRESH_EXPIRES_IN=7d
# Optional: dedicated secret for signed lesson video URLs (defaults to JWT_SECRET)
# JWT_ACCESS_SECRET=

# Return OTP as `devCode` in API responses (development/test only). Ignored/forbidden in production.
# Production OTP delivery is configured in Admin → OTP/SMS (Kavenegar API key + verify template).
OTP_DEV_EXPOSE=true

# Set to true when the API sits behind a reverse proxy (correct client IP + secure cookies).
# TRUST_PROXY=true

# Optional Redis for multi-replica rate limiting (redis:// or rediss://).
# REDIS_URL=redis://127.0.0.1:6379

# Optional cookie SameSite override ('none' when web + API are on different sites).
# COOKIE_SAMESITE=lax

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=KiaDot <noreply@kia.academy>

# Online class / event join links. Leave unset to show an honest "not configured" state.
# CONFERENCE_PROVIDER=jitsi
# CONFERENCE_PROVIDER_URL=https://meet.example.com/kiadot

# Lesson Motion Studio. Leave unset to analyze lessons locally with no API key.
# All three AI vars are required together. Secrets stay on the server.
# MOTION_AI_BASE_URL=https://api.openai.com/v1
# MOTION_AI_API_KEY=
# MOTION_AI_MODEL=
# MOTION_TTS_BASE_URL=
# MOTION_TTS_API_KEY=
# MOTION_TTS_MODEL=
